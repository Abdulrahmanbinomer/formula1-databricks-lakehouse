digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.48"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.18,0.11", color="#16325c", fontcolor="#10233f"];
  edge [color="#55708f", penwidth=1.5, arrowsize=0.8];
  landing [label="Landing batch folders", fillcolor="#f4ecda"];
  control [label="Read batch_control\ntracked = in_progress + completed", fillcolor="#e8f1fb"];
  select [label="Sort untracked folders\nselect earliest next_batch", fillcolor="#dcebdc"];
  progress [label="Append batch_control status\nin_progress", fillcolor="#f4d8bf"];
  pipeline [label="Bronze → Silver → Gold\nusing p_batch_id", fillcolor="#e3ddf3"];
  completed [label="Delta MERGE status\ncompleted", fillcolor="#d9edf3"];
  landing -> control -> select -> progress -> pipeline -> completed;
}
